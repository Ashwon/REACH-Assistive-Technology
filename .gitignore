# never commit secrets or build junk
.env
*.keystore
local.properties
android/.gradle/
android/app/build/
android/build/
*.apk
backend/__pycache__/
# model files are downloaded, not committed (large)
android/app/src/main/assets/*.task
android/app/src/main/assets/*.tflite
.DS_Store
.claude/
# candidate models and large recorded datasets stay local (dataset/seed is small and kept)
models/
dataset/*/predictions/
dataset/*/images/
!dataset/seed/images/
__pycache__/
