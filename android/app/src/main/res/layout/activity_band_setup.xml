<?xml version="1.0" encoding="utf-8"?>
<!-- Vibration band setup. One step at a time; buttons are configured per step by BandSetupActivity. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/reach_bg"
    android:fillViewport="true"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="24dp"
        android:paddingVertical="24dp">

        <TextView
            android:id="@+id/stepLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textAppearance="@style/TextAppearance.Reach.Label" />

        <!-- How far through the setup, at a glance -->
        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/progress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:importantForAccessibility="no"
            app:indicatorColor="@color/reach_primary"
            app:trackColor="@color/reach_surface_high"
            app:trackCornerRadius="4dp"
            app:trackThickness="6dp" />

        <TextView
            android:id="@+id/title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:accessibilityHeading="true"
            android:textAppearance="@style/TextAppearance.Material3.HeadlineSmall"
            android:textColor="@color/reach_text" />

        <!-- Shown on the motor test and practice steps: nothing here is live guidance -->
        <TextView
            android:id="@+id/practice"
            style="@style/Widget.Reach.Pill"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/band_practice_label"
            android:textColor="@color/reach_warn"
            android:visibility="gone" />

        <TextView
            android:id="@+id/body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_setup_card"
            android:padding="18dp"
            android:accessibilityLiveRegion="polite"
            android:lineSpacingMultiplier="1.15"
            android:textAppearance="@style/TextAppearance.Material3.BodyLarge"
            android:textColor="@color/reach_text"
            android:textSize="18sp" />

        <!-- The real link state, always shown -->
        <TextView
            android:id="@+id/bandStatus"
            style="@style/Widget.Reach.Pill"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:accessibilityLiveRegion="polite" />

        <!-- The practice list (one entry per taught pattern), filled in code -->
        <LinearLayout
            android:id="@+id/patterns"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="vertical"
            android:visibility="gone" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:minHeight="60dp"
            android:textSize="18sp"
            android:textStyle="bold"
            app:cornerRadius="18dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn2"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:minHeight="60dp"
            android:textSize="17sp"
            app:cornerRadius="18dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn3"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:minHeight="60dp"
            android:textSize="17sp"
            app:cornerRadius="18dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn4"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:minHeight="60dp"
            android:textSize="17sp"
            app:cornerRadius="18dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn5"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:minHeight="60dp"
            android:textSize="17sp"
            app:cornerRadius="18dp" />

        <!-- Immediate stop, on every step -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnStopVibration"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:minHeight="56dp"
            android:text="@string/band_stop"
            android:textColor="@color/reach_text"
            android:textSize="17sp"
            app:cornerRadius="18dp"
            app:strokeColor="@color/reach_text_secondary" />
    </LinearLayout>
</ScrollView>
