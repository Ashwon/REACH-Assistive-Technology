<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/reach_bg"
    android:fillViewport="true"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingTop="18dp"
        android:paddingBottom="24dp">

        <!-- Brand header & step badge -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_pill"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="12dp"
                android:paddingVertical="5dp">

                <View
                    android:layout_width="8dp"
                    android:layout_height="8dp"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/bg_dot"
                    android:backgroundTint="@color/reach_good" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-black"
                    android:letterSpacing="0.16"
                    android:text="@string/app_name"
                    android:textColor="@color/reach_text"
                    android:textSize="12sp" />
            </LinearLayout>

            <Space
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/stepLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_badge_tint"
                android:backgroundTint="@color/reach_primary_container"
                android:fontFamily="sans-serif-medium"
                android:paddingHorizontal="12dp"
                android:paddingVertical="5dp"
                android:textColor="@color/reach_on_primary_container"
                android:textSize="12sp"
                android:textStyle="bold"
                tools:text="Step 1 of 7" />
        </LinearLayout>

        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/progress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:max="100"
            app:indicatorColor="@color/reach_primary"
            app:trackColor="@color/reach_surface_high"
            app:trackCornerRadius="4dp"
            app:trackThickness="6dp" />

        <!-- Hero Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:background="@drawable/bg_setup_card"
            android:orientation="vertical"
            android:padding="22dp">

            <FrameLayout
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:background="@drawable/bg_hero_badge">

                <ImageView
                    android:id="@+id/bandHeroIcon"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_gravity="center"
                    android:contentDescription="@string/band_hero_desc"
                    android:src="@drawable/ic_spark"
                    app:tint="@color/reach_primary" />
            </FrameLayout>

            <TextView
                android:id="@+id/title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:accessibilityHeading="true"
                android:textColor="@color/reach_text"
                android:textSize="26sp"
                android:textStyle="bold"
                tools:text="Welcome to REACH" />

            <TextView
                android:id="@+id/practice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_badge_tint"
                android:backgroundTint="@color/reach_good_container"
                android:paddingHorizontal="12dp"
                android:paddingVertical="5dp"
                android:text="@string/band_practice_label"
                android:textColor="@color/reach_good"
                android:textSize="12sp"
                android:textStyle="bold"
                android:visibility="gone"
                tools:visibility="visible" />

            <TextView
                android:id="@+id/body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:lineSpacingMultiplier="1.35"
                android:textColor="@color/reach_text_secondary"
                android:textSize="16sp"
                tools:text="REACH helps you locate objects with real-time voice guidance and optional wristband haptics." />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_badge_tint"
                android:backgroundTint="@color/reach_bg"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="14dp"
                android:paddingVertical="10dp">

                <View
                    android:id="@+id/bandStatusDot"
                    android:layout_width="9dp"
                    android:layout_height="9dp"
                    android:layout_marginEnd="10dp"
                    android:background="@drawable/bg_dot"
                    android:backgroundTint="@color/reach_warn" />

                <TextView
                    android:id="@+id/bandStatus"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textColor="@color/reach_text"
                    android:textSize="13.5sp"
                    tools:text="Band status: ready to scan" />
            </LinearLayout>

            <!-- Container for interactive haptic pattern rows -->
            <LinearLayout
                android:id="@+id/patterns"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="vertical"
                android:visibility="gone" />
        </LinearLayout>

        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- Action Deck -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:orientation="vertical">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn1"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:textAllCaps="false"
                android:textColor="@color/reach_on_primary"
                android:textSize="16sp"
                android:textStyle="bold"
                android:visibility="gone"
                app:backgroundTint="@color/reach_primary"
                app:cornerRadius="18dp"
                tools:text="Continue"
                tools:visibility="visible" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn2"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="10dp"
                android:textAllCaps="false"
                android:textColor="@color/reach_text"
                android:textSize="15.5sp"
                android:visibility="gone"
                app:backgroundTint="@color/reach_surface_high"
                app:cornerRadius="16dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn3"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="10dp"
                android:textAllCaps="false"
                android:textColor="@color/reach_text_secondary"
                android:textSize="15sp"
                android:visibility="gone"
                app:cornerRadius="16dp"
                app:strokeColor="@color/reach_outline_card" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn4"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="8dp"
                android:textAllCaps="false"
                android:textColor="@color/reach_text_secondary"
                android:textSize="14.5sp"
                android:visibility="gone" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn5"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="4dp"
                android:textAllCaps="false"
                android:textColor="@color/reach_text_muted"
                android:textSize="14sp"
                android:visibility="gone" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnStopVibration"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="12dp"
                android:text="@string/band_stop"
                android:textAllCaps="false"
                android:textColor="@color/reach_warn"
                android:visibility="gone"
                app:cornerRadius="16dp"
                app:icon="@drawable/ic_close"
                app:iconTint="@color/reach_warn"
                app:strokeColor="@color/reach_warn_container" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
