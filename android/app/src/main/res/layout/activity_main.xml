<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/reach_bg"
    tools:context=".MainActivity">

    <!-- Live camera stream -->
    <androidx.camera.view.PreviewView
        android:id="@+id/preview"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:implementationMode="compatible"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- ARCore camera feed (only visible in Depth camera mode) -->
    <ImageView
        android:id="@+id/arPreview"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:contentDescription="@null"
        android:scaleType="centerCrop"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <FrameLayout
        android:id="@+id/glHost"
        android:layout_width="1dp"
        android:layout_height="1dp"
        android:visibility="gone"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Spatial AR HUD overlay -->
    <com.reach.app.ui.OverlayView
        android:id="@+id/overlay"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Top floating HUD -->
    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_hud_top_scrim"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:orientation="vertical"
        android:paddingHorizontal="14dp"
        android:paddingTop="12dp"
        android:paddingBottom="18dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <!-- Status pill + quick icon controls -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:layout_weight="1">

                <LinearLayout
                    android:id="@+id/statusPill"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:background="@drawable/bg_pill"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="13dp">

                    <View
                        android:id="@+id/statusDot"
                        android:layout_width="9dp"
                        android:layout_height="9dp"
                        android:layout_marginEnd="8dp"
                        android:background="@drawable/bg_dot"
                        android:backgroundTint="@color/reach_good" />

                    <TextView
                        android:id="@+id/statusText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:fontFamily="sans-serif-medium"
                        android:maxLines="1"
                        android:textAppearance="@style/TextAppearance.Reach.Pill"
                        android:textStyle="bold"
                        tools:text="Ready" />
                </LinearLayout>
            </FrameLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnHand"
                style="@style/Widget.Reach.HudIconButton"
                android:layout_marginEnd="2dp"
                android:contentDescription="@string/set_hand_desc"
                app:icon="@drawable/ic_hand" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSpeech"
                style="@style/Widget.Reach.HudIconButton"
                android:layout_marginEnd="2dp"
                android:contentDescription="@string/speech_on_desc"
                app:icon="@drawable/ic_volume_up" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnHelp"
                style="@style/Widget.Reach.HudIconButton"
                android:layout_marginEnd="2dp"
                android:contentDescription="@string/help_desc"
                app:icon="@drawable/ic_help" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSettings"
                style="@style/Widget.Reach.HudIconButton"
                android:contentDescription="@string/settings_desc"
                app:icon="@drawable/ic_tune" />
        </LinearLayout>

        <!-- Single-row scrollable telemetry chips (keeps ~85% of camera uncluttered) -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:clipToPadding="false"
            android:overScrollMode="never"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/chipObject"
                    style="@style/Widget.Reach.Pill"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp"
                    android:visibility="gone"
                    tools:text="Bottle 94%"
                    tools:visibility="visible" />

                <TextView
                    android:id="@+id/chipHand"
                    style="@style/Widget.Reach.Pill"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp"
                    android:visibility="gone"
                    tools:text="Right hand"
                    tools:visibility="visible" />

                <TextView
                    android:id="@+id/chipDistance"
                    style="@style/Widget.Reach.Pill"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp"
                    android:visibility="gone"
                    tools:text="42 cm"
                    tools:visibility="visible" />

                <TextView
                    android:id="@+id/chipHaptic"
                    style="@style/Widget.Reach.Pill"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:visibility="gone"
                    tools:text="Band ready"
                    tools:visibility="visible" />
            </LinearLayout>
        </HorizontalScrollView>

        <!-- High-visibility directional turn warning banner -->
        <TextView
            android:id="@+id/chipTurn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_badge_tint"
            android:backgroundTint="@color/reach_warn_container"
            android:fontFamily="sans-serif-medium"
            android:paddingHorizontal="14dp"
            android:paddingVertical="7dp"
            android:textColor="@color/reach_warn"
            android:textSize="13sp"
            android:textStyle="bold"
            android:visibility="gone"
            tools:text="Turn left toward the bottle" />
    </LinearLayout>

    <!-- Camera blocked / initializing card -->
    <LinearLayout
        android:id="@+id/cameraMessage"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="24dp"
        android:background="@drawable/bg_setup_card"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="24dp"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@id/bottomBar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/topBar"
        app:layout_constraintWidth_max="360dp">

        <FrameLayout
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:layout_marginBottom="14dp"
            android:background="@drawable/bg_badge_tint"
            android:backgroundTint="@color/reach_warn_container">

            <ImageView
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:layout_gravity="center"
                android:contentDescription="@null"
                android:src="@drawable/ic_videocam_off"
                app:tint="@color/reach_warn" />
        </FrameLayout>

        <TextView
            android:id="@+id/cameraMessageTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textColor="@color/reach_text"
            android:textSize="20sp"
            android:textStyle="bold"
            tools:text="Camera paused" />

        <TextView
            android:id="@+id/cameraMessageBody"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:lineSpacingMultiplier="1.25"
            android:textColor="@color/reach_text_secondary"
            android:textSize="14.5sp"
            tools:text="Allow camera access to detect objects and guide your reach." />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCameraAction"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:minHeight="48dp"
            android:textAllCaps="false"
            android:textColor="@color/reach_on_primary"
            android:textStyle="bold"
            app:backgroundTint="@color/reach_primary"
            app:cornerRadius="16dp" />
    </LinearLayout>

    <!-- Bottom floating dock -->
    <LinearLayout
        android:id="@+id/bottomBar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_bottom_scrim"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:orientation="vertical"
        android:paddingHorizontal="14dp"
        android:paddingTop="18dp"
        android:paddingBottom="14dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <!-- Spatial guidance hero card -->
        <LinearLayout
            android:id="@+id/guidanceCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_guidance_card"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingVertical="14dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/guidanceMode"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_badge_tint"
                    android:backgroundTint="@color/reach_primary_container"
                    android:fontFamily="sans-serif-medium"
                    android:letterSpacing="0.06"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="3dp"
                    android:textAllCaps="true"
                    android:textColor="@color/reach_on_primary_container"
                    android:textSize="10.5sp"
                    android:textStyle="bold"
                    android:visibility="gone"
                    tools:text="Direction only"
                    tools:visibility="visible" />

                <Space
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <LinearLayout
                    android:id="@+id/voiceWakePill"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_pill"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="3dp">

                    <View
                        android:layout_width="6dp"
                        android:layout_height="6dp"
                        android:layout_marginEnd="6dp"
                        android:background="@drawable/bg_dot"
                        android:backgroundTint="@color/reach_primary" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        android:text="@string/voice_wake_badge"
                        android:textColor="@color/reach_text_secondary"
                        android:textSize="11sp" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <FrameLayout
                    android:id="@+id/cueBadge"
                    android:layout_width="46dp"
                    android:layout_height="46dp"
                    android:layout_marginEnd="14dp"
                    android:background="@drawable/bg_hero_badge">

                    <ImageView
                        android:id="@+id/cueIcon"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_gravity="center"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_spark"
                        app:tint="@color/reach_primary" />
                </FrameLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/guidanceText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textAppearance="@style/TextAppearance.Reach.Guidance"
                        tools:text="Point camera toward target" />

                    <TextView
                        android:id="@+id/guidanceDetail"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:textColor="@color/reach_text_secondary"
                        android:textSize="14sp"
                        tools:text="Tap a quick object below or say Reach" />
                </LinearLayout>
            </LinearLayout>

            <com.google.android.material.progressindicator.LinearProgressIndicator
                android:id="@+id/alignBar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:max="100"
                android:progress="0"
                android:visibility="gone"
                app:indicatorColor="@color/reach_primary"
                app:trackColor="@color/reach_outline_card"
                app:trackCornerRadius="4dp"
                app:trackThickness="5dp"
                tools:progress="72"
                tools:visibility="visible" />

            <TextView
                android:id="@+id/lastSpoken"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/reach_text_muted"
                android:textSize="12sp"
                android:visibility="gone"
                tools:text="Spoken: Move left."
                tools:visibility="visible" />
        </LinearLayout>

        <!-- Quick target + torch strip -->
        <LinearLayout
            android:id="@+id/quickTargetBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnQuickBottle"
                style="@style/Widget.Reach.QuickTile"
                android:layout_width="0dp"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:contentDescription="Find Bottle"
                android:text="@string/quick_bottle"
                app:icon="@drawable/ic_bottle" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnQuickLaptop"
                style="@style/Widget.Reach.QuickTile"
                android:layout_width="0dp"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:contentDescription="Find Laptop"
                android:text="@string/quick_laptop"
                app:icon="@drawable/ic_laptop" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnTorch"
                style="@style/Widget.Reach.QuickTile"
                android:layout_width="0dp"
                android:layout_weight="0.95"
                android:contentDescription="Toggle Flashlight"
                android:text="@string/quick_torch"
                app:icon="@drawable/ic_flashlight" />
        </LinearLayout>

        <!-- Custom search / command input bar -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/inputLayout"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            app:boxBackgroundColor="@color/reach_surface_glass"
            app:boxCornerRadiusBottomEnd="22dp"
            app:boxCornerRadiusBottomStart="22dp"
            app:boxCornerRadiusTopEnd="22dp"
            app:boxCornerRadiusTopStart="22dp"
            app:boxStrokeColor="@color/reach_outline"
            app:boxStrokeWidth="1dp"
            app:boxStrokeWidthFocused="1.5dp"
            app:endIconContentDescription="@string/mic_desc"
            app:endIconDrawable="@drawable/ic_mic"
            app:endIconMode="custom"
            app:endIconTint="@color/reach_primary"
            app:helperTextTextColor="@color/reach_text_muted"
            app:hintEnabled="false">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/inputText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/input_hint"
                android:imeOptions="actionSearch"
                android:inputType="text"
                android:maxLines="1"
                android:minHeight="48dp"
                android:paddingVertical="12dp"
                android:textColor="@color/reach_text"
                android:textColorHint="@color/reach_text_secondary"
                android:textSize="15sp" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Primary / secondary action controls -->
        <LinearLayout
            android:id="@+id/actions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnStop"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="54dp"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:text="@string/cancel"
                android:textAllCaps="false"
                android:textColor="@color/reach_text"
                android:textSize="15.5sp"
                android:textStyle="bold"
                android:visibility="gone"
                app:backgroundTint="@color/reach_surface_glass"
                app:cornerRadius="18dp"
                app:strokeColor="@color/reach_outline"
                app:strokeWidth="1dp"
                tools:visibility="visible" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnPrimary"
                android:layout_width="0dp"
                android:layout_height="54dp"
                android:layout_weight="1.5"
                android:text="@string/find_object"
                android:textAllCaps="false"
                android:textColor="@color/reach_on_primary"
                android:textSize="16sp"
                android:textStyle="bold"
                app:backgroundTint="@color/reach_primary"
                app:cornerRadius="18dp"
                app:icon="@drawable/ic_search"
                app:iconGravity="textStart"
                app:iconPadding="8dp"
                app:iconTint="@color/reach_on_primary" />
        </LinearLayout>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
