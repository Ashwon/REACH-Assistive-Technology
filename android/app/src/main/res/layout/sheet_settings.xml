<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/reach_surface"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingTop="12dp"
        android:paddingBottom="28dp">

        <!-- Bottom sheet drag handle -->
        <View
            android:layout_width="42dp"
            android:layout_height="4dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="16dp"
            android:background="@drawable/bg_badge_tint"
            android:backgroundTint="#3DFFFFFF" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/settings_sheet_title"
            android:textColor="@color/reach_text"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/settings_subtitle"
            android:textColor="@color/reach_text_secondary"
            android:textSize="13.5sp" />

        <!-- Card 1: Camera & Mount -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:background="@drawable/bg_setup_card"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:accessibilityHeading="true"
                android:text="@string/camera_title"
                android:textAppearance="@style/TextAppearance.Reach.Label"
                android:textColor="@color/reach_primary" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="@string/settings_camera_sub"
                android:textColor="@color/reach_text_secondary"
                android:textSize="13sp" />

            <RadioGroup
                android:id="@+id/cameraGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginVertical="10dp"
                android:background="@color/reach_outline_card" />

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/switchChest"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:text="@string/chest_mounted"
                android:textColor="@color/reach_text"
                android:textSize="15.5sp" />
        </LinearLayout>

        <!-- Card 2: Voice & Hands -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_setup_card"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:accessibilityHeading="true"
                android:text="@string/settings_title"
                android:textAppearance="@style/TextAppearance.Reach.Label"
                android:textColor="@color/reach_primary" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="@string/settings_voice_sub"
                android:textColor="@color/reach_text_secondary"
                android:textSize="13sp" />

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/switchSpeech"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:minHeight="48dp"
                android:text="@string/spoken_guidance"
                android:textColor="@color/reach_text"
                android:textSize="15.5sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/volumeLabel"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/guidance_volume"
                    android:textColor="@color/reach_text_secondary"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/volumeValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_badge_tint"
                    android:backgroundTint="@color/reach_primary_container"
                    android:fontFamily="sans-serif-medium"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="3dp"
                    android:textColor="@color/reach_on_primary_container"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    tools:text="85%" />
            </LinearLayout>

            <com.google.android.material.slider.Slider
                android:id="@+id/sliderVolume"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:contentDescription="@string/guidance_volume"
                android:stepSize="0.05"
                android:valueFrom="0.1"
                android:valueTo="1.0"
                app:thumbColor="@color/reach_primary"
                app:trackColorActive="@color/reach_primary"
                app:trackColorInactive="@color/reach_surface_high" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnTestVoice"
                style="@style/Widget.Reach.SettingsAction"
                android:layout_marginTop="6dp"
                android:text="@string/test_voice"
                app:icon="@drawable/ic_volume_up" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnTutorial"
                style="@style/Widget.Reach.SettingsAction"
                android:layout_marginTop="8dp"
                android:text="@string/replay_intro"
                app:icon="@drawable/ic_help" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnHands"
                style="@style/Widget.Reach.SettingsAction"
                android:layout_marginTop="8dp"
                android:text="@string/setup_hands"
                app:icon="@drawable/ic_hand" />
        </LinearLayout>

        <!-- Card 3: Haptic Wristband -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_setup_card"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:accessibilityHeading="true"
                android:text="@string/band_title"
                android:textAppearance="@style/TextAppearance.Reach.Label"
                android:textColor="@color/reach_primary" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="@string/settings_band_sub"
                android:textColor="@color/reach_text_secondary"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/bandStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_badge_tint"
                android:backgroundTint="@color/reach_bg"
                android:paddingHorizontal="12dp"
                android:paddingVertical="10dp"
                android:textColor="@color/reach_text"
                android:textSize="13.5sp"
                tools:text="Band: disconnected. Haptic guidance: off." />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnBandConnect"
                style="@style/Widget.Reach.SettingsAction"
                android:layout_marginTop="10dp"
                android:text="@string/band_reconnect"
                app:icon="@drawable/ic_bluetooth" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnBandTest"
                style="@style/Widget.Reach.SettingsAction"
                android:layout_marginTop="8dp"
                android:text="@string/band_self_test"
                app:icon="@drawable/ic_center_target" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnBandReview"
                style="@style/Widget.Reach.SettingsAction"
                android:layout_marginTop="8dp"
                android:text="@string/band_review"
                app:icon="@drawable/ic_spark" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnBandStop"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:minHeight="48dp"
                android:text="@string/band_stop"
                android:textAllCaps="false"
                android:textColor="@color/reach_warn"
                app:cornerRadius="16dp"
                app:icon="@drawable/ic_close"
                app:iconTint="@color/reach_warn"
                app:strokeColor="@color/reach_warn_container" />
        </LinearLayout>

        <!-- Card 4: Tools & Live Diagnostics -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_setup_card"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:accessibilityHeading="true"
                android:text="@string/diagnostics_title"
                android:textAppearance="@style/TextAppearance.Reach.Label"
                android:textColor="@color/reach_primary" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="@string/settings_tools_sub"
                android:textColor="@color/reach_text_secondary"
                android:textSize="13sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnDepth"
                style="@style/Widget.Reach.SettingsAction"
                android:layout_marginTop="10dp"
                android:text="@string/depth_check"
                app:icon="@drawable/ic_navigation" />

            <TextView
                android:id="@+id/diagnostics"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_badge_tint"
                android:backgroundTint="@color/reach_bg"
                android:fontFamily="monospace"
                android:lineSpacingMultiplier="1.35"
                android:padding="12dp"
                android:textColor="@color/reach_text_secondary"
                android:textSize="11.5sp"
                tools:text="Camera: 0\nEngine: Active\nDetections: bottle" />
        </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
